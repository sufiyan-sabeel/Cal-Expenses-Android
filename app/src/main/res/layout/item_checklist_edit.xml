<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingVertical="4dp">

    <CheckBox android:id="@+id/cbItem" android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    <EditText android:id="@+id/etItem" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"
        android:textSize="15sp" android:background="@null" android:hint="Item" />
    <ImageView android:id="@+id/btnRemove" android:layout_width="36dp"
        android:layout_height="36dp" android:padding="8dp"
        android:src="@drawable/ic_delete" android:contentDescription="@string/delete" />
</LinearLayout>
