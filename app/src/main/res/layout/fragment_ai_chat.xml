<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?android:attr/colorBackground">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="8dp" android:paddingVertical="4dp">
        <ImageView android:id="@+id/btnChats" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="10dp" android:src="@drawable/ic_transactions"
            android:contentDescription="Conversations"
            android:background="?attr/selectableItemBackgroundBorderless" />
        <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:text="@string/ai_title"
            android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold" />
        <ImageView android:id="@+id/btnNewChat" android:layout_width="44dp" android:layout_height="44dp"
            android:padding="10dp" android:src="@drawable/ic_new_chat"
            android:contentDescription="New chat"
            android:background="?attr/selectableItemBackgroundBorderless" />
    </LinearLayout>

    <LinearLayout android:id="@+id/bannerNoKey" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:padding="12dp" android:layout_marginHorizontal="12dp"
        android:background="@drawable/bg_card">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Add your OpenRouter API key to use Cal AI."
            android:textColor="@color/text_secondary" android:textSize="13sp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnSetKey"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Set key" android:insetTop="0dp" android:insetBottom="0dp" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingHorizontal="16dp" android:paddingVertical="4dp">
        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:text="Include my spending summary (sent to OpenRouter)"
            android:textColor="@color/text_secondary" android:textSize="12sp" />
        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/swContext"
            android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingVertical="8dp" />

    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical"
        android:gravity="center" android:padding="24dp">
        <ImageView android:layout_width="48dp" android:layout_height="48dp"
            android:src="@drawable/ic_ai" android:alpha="0.6"
            android:contentDescription="@string/ai_title" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Ask Cal AI about your money"
            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" android:text="Runs on OpenRouter's free models. Your chats stay on this device."
            android:textColor="@color/text_secondary" android:textSize="13sp" android:gravity="center" />
        <com.google.android.material.button.MaterialButton android:id="@+id/chip1"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="How much did I spend this month?" />
        <com.google.android.material.button.MaterialButton android:id="@+id/chip2"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Which categories use the most budget?" />
        <com.google.android.material.button.MaterialButton android:id="@+id/chip3"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="Help me plan my remaining budget." />
    </LinearLayout>

    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp"
        android:indeterminate="true" android:visibility="gone" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:padding="8dp" android:layout_marginBottom="4dp">
        <EditText android:id="@+id/etInput" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/bg_input"
            android:hint="Message Cal AI" android:textColorHint="@color/text_secondary"
            android:textColor="@color/text_primary" android:textSize="15sp"
            android:paddingHorizontal="16dp" android:paddingVertical="12dp"
            android:maxLines="4" android:inputType="textMultiLine|textCapSentences" />
        <ImageButton android:id="@+id/btnSend" android:layout_width="48dp" android:layout_height="48dp"
            android:layout_marginStart="6dp" android:padding="12dp" android:src="@drawable/ic_send"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Send" android:tint="@color/accent_cyan" />
    </LinearLayout>
</LinearLayout>
